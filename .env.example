# Copy to .env and adjust if needed. docker-compose.yml already provides
# sensible defaults for local use, so this file is only needed for overrides.

# Backend
# Postgres credentials for the `db` service (docker-compose.yml builds
# DATABASE_URL from these automatically - only override if you need
# non-default credentials or an external database).
POSTGRES_DB=grade_tracker
POSTGRES_USER=grade_tracker
POSTGRES_PASSWORD=grade_tracker

# Signs login tokens - change this to a random value so logins survive
# beyond the insecure built-in default and so nobody else can forge tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-in-production

# Outgoing mail for email verification / password reset codes. Leave
# SMTP_HOST unset for local use - codes are logged by the backend instead
# of emailed, so the flow still works without a mail server configured.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=Grade Tracker <no-reply@example.com>
#SMTP_USE_TLS=true

# Set to "production" for a real deployment (the deploy workflow sets this).
# When set, the backend refuses to start with the default SECRET_KEY, and
# warns if ALLOWED_ORIGINS is still wide open. Leave unset for local use.
#APP_ENV=production

# Comma-separated list of origins allowed to call the API (your deployed
# frontend's URL, e.g. https://app.example.com). Leave unset/"*" for local
# use - a real deployment should restrict this.
#ALLOWED_ORIGINS=https://app.example.com

# Optional error tracking (https://sentry.io or self-hosted). Leave unset
# to disable - nothing is sent anywhere without a DSN.
#SENTRY_DSN=

# Frontend (must be reachable from your browser, not just inside Docker)
NEXT_PUBLIC_API_URL=http://localhost:5001
